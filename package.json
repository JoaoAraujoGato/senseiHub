{
  "name": "sensei-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sensei Hub - gerenciamento de academias de artes marciais (frontend + backend)",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --watch backend backend/src/index.js",
    "dev:frontend": "vite frontend",
    "start": "node backend/src/index.js",
    "build": "vite build frontend",
    "preview": "vite preview frontend",
    "lint": "cd frontend && eslint ."
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "axios": "1.16.1",
    "bcryptjs": "3.0.3",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "js-var-type": "0.2.6",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.76.1",
    "react-icons": "5.6.0",
    "styled-components": "6.4.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "^9.1.0",
    "eslint": "9.13.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.11.0",
    "nodemon": "3.1.14",
    "sass": "1.99.0",
    "vite": "5.4.10"
  }
}

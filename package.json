{
  "name": "sensei-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sensei Hub - gerenciamento de academias de artes marciais (frontend + backend)",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --watch backend backend/src/index.js",
    "dev:frontend": "vite frontend",
    "start": "node backend/src/index.js",
    "build": "vite build frontend",
    "preview": "vite preview frontend",
    "lint": "cd frontend && eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@reduxjs/toolkit": "^2.5.0",
    "bcryptjs": "3.0.3",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "js-var-type": "0.2.6",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.76.1",
    "react-icons": "5.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.1",
    "styled-components": "6.4.2",
    "swagger-ui-express": "5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "concurrently": "^9.1.0",
    "eslint": "9.13.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.11.0",
    "jsdom": "^25.0.1",
    "nodemon": "3.1.14",
    "sass": "1.99.0",
    "vite": "5.4.10",
    "vitest": "^2.1.8"
  }
}
